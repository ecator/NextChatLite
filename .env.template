# ==============================================================================
# Model Provider API Keys
# (Read dynamically in real-time according to env declarations in public/providers.json)
# ==============================================================================

# Google Gemini API key
GOOGLE_API_KEY=

# OpenAI API key
OPENAI_API_KEY=

# Anthropic Claude API key
ANTHROPIC_API_KEY=

# DeepSeek API key
DEEPSEEK_API_KEY=

# ==============================================================================
# Server & Network Configuration
# ==============================================================================

# Network proxy for server-side outbound requests (optional)
# Example: http://127.0.0.1:7890
PROXY_URL=

# ==============================================================================
# Application & UI Customization
# ==============================================================================

# Default model in provider/model format (optional)
# If empty, defaults to the first model in public/providers.json (e.g. google/gemini-3.5-flash)
# Examples: google/gemini-3.5-flash, openai/gpt-5.1
NEXTCHATLITE_DEFAULT_MODEL=

# Custom application title for sidebar header and document.title (optional)
# Default: NextChatLite
NEXTCHATLITE_TITLE=

# Custom application subtitle for sidebar header (optional)
# Default: Your own AI assistant.
NEXTCHATLITE_SUBTITLE=

# Custom help URL for sidebar lower-left corner icon link (optional)
# If set, a help icon appears in the sidebar bottom-left corner and navigates to this URL
# Example: https://docs.nextchatlite.io/help
NEXTCHATLITE_HELP_URL=

# Default input template for user prompt preprocessing (optional)
# Available placeholders: {{input}}, {{ServiceProvider}}, {{model}}, {{time}}, {{cutoff}}, {{lang}}
# Default: {{input}}
NEXTCHATLITE_DEFAULT_INPUT_TEMPLATE=

# Custom global system prompt template injected at the beginning of conversations (optional)
# Injected when "Inject System Prompts" is enabled in settings (works across all models).
# Available placeholders:
#   {{ServiceProvider}} - AI provider / model trainer name (e.g. Google, OpenAI, Anthropic, DeepSeek)
#   {{model}}           - Current model name (e.g. gemini-3.5-flash, gpt-5.1)
#   {{time}}            - Current client date and time string
#   {{cutoff}}          - Knowledge cutoff date of the model (e.g. 2024-01)
#   {{lang}}            - Current UI language code (e.g. en, cn)
#   {{input}}           - User message content (empty in global system prompt)
# Fallback Default:
#   You are a helpful AI assistant trained by {{ServiceProvider}}.
#   Knowledge cutoff: {{cutoff}}
#   Current model: {{model}}
#   Current time: {{time}}
#   Latex inline: \(x^2\) 
#   Latex block: $$e=mc^2$$
NEXTCHATLITE_DEFAULT_SYSTEM_TEMPLATE=
