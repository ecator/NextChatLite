{
  "name": "nextchat",
  "version": "2.16.1",
  "private": false,
  "license": "mit",
  "scripts": {
    "mask": "npx tsx app/masks/build.ts",
    "mask:watch": "npx watch \"pnpm mask\" app/masks",
    "dev": "concurrently -r \"pnpm run mask:watch\" \"next dev\"",
    "build": "pnpm mask && cross-env BUILD_MODE=standalone next build",
    "start": "next start",
    "lint": "eslint app test tests",
    "prompts": "node ./scripts/fetch-prompts.mjs",
    "prepare": "husky install",
    "proxy-dev": "sh ./scripts/init-proxy.sh && proxychains -f ./scripts/proxychains.conf pnpm dev",
    "test": "jest --watch",
    "test:ci": "jest --ci",
    "test:e2e": "tsx --test \"tests/e2e/**/*.test.ts\""
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.1.6",
    "@ai-sdk/google": "^1.1.10",
    "@ai-sdk/openai": "^1.1.9",
    "@ai-sdk/react": "^1.1.9",
    "@hello-pangea/dnd": "^17.0.0",
    "@next/third-parties": "^15.1.0",
    "@opencode-ai/models": "^0.0.8",
    "@svgr/webpack": "^8.1.0",
    "@vercel/analytics": "^0.1.11",
    "@vercel/speed-insights": "^1.0.2",
    "ai": "^4.1.45",
    "axios": "^1.7.5",
    "clsx": "^2.1.1",
    "emoji-picker-react": "^4.9.2",
    "fuse.js": "^7.0.0",
    "heic2any": "^0.0.4",
    "html-to-image": "^1.11.11",
    "idb-keyval": "^6.2.1",
    "js-yaml": "^4.1.0",
    "katex": "^0.16.11",
    "lodash-es": "^4.17.21",
    "markdown-to-txt": "^2.0.1",
    "mermaid": "^10.6.1",
    "nanoid": "^5.0.3",
    "next": "^16.0.0",
    "node-fetch": "^3.3.1",
    "openapi-client-axios": "^7.5.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3",
    "react-router-dom": "^6.15.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "rt-client": "https://github.com/Azure-Samples/aoai-realtime-audio-sdk/releases/download/js/v0.5.0/rt-client-0.5.0.tgz",
    "sass": "^1.59.2",
    "spark-md5": "^3.0.2",
    "use-debounce": "^9.0.4",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.11.30",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-katex": "^3.0.0",
    "@types/spark-md5": "^3.0.4",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "csstype": "^3.1.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.1.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-unused-imports": "^3.2.0",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^13.2.2",
    "prettier": "^3.0.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.0",
    "typescript": "^5.6.3",
    "watch": "^1.0.2",
    "webpack": "^5.88.1"
  },
  "resolutions": {
    "lint-staged/yaml": "^2.2.2"
  },
  "packageManager": "pnpm@11.24.0"
}
